#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/utila-grpc-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' 0
trap 'exit 1' HUP INT TERM

git checkout-index --all --prefix="$snapshot/"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
cd "$snapshot"
printf '%s\n' "Checking staged Go formatting, tests, and static analysis..."
make lint test
